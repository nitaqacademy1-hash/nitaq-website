# ─────────────────────────────────────────────
# Nitaq Academy — SAT Diagnostic Backend
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://nitaq_user:your_secure_password@localhost:5432/nitaq_sat

# JWT secret key — generate with: openssl rand -hex 32
SECRET_KEY=change_me_to_a_long_random_string

# Admin bootstrap secret (used when creating the first super-admin)
ADMIN_BOOTSTRAP_SECRET=change_me_to_another_long_random_string

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated list of allowed origins
# Development:   http://localhost:5173,http://localhost:3000
# Production:    https://nitaqacademy.com,https://admin.nitaqacademy.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://nitaqacademy.com,https://admin.nitaqacademy.com

# Environment: development | production
ENVIRONMENT=development

# Optional: Email (Resend / SMTP) — leave blank to skip email sending
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@nitaqacademy.com

# Frontend base URL (used in email result links)
FRONTEND_URL=https://nitaqacademy.com

# Optional: Google Sheets export service account JSON (base64-encoded)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Rate limiting (requests per minute per IP for public endpoints)
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_ADMIN=60
