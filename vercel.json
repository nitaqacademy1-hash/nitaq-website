{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sat-preparation",
      "destination": "/sat-preparation-sharjah",
      "permanent": true
    },
    {
      "source": "/ar/sat-preparation",
      "destination": "/ar/sat-preparation-sharjah",
      "permanent": true
    },
    {
      "source": "/webinar",
      "destination": "/webinar/ai",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ar/(.*)",
      "destination": "/ar/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}