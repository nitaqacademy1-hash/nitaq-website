{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sat-preparation",
      "destination": "/sat-preparation-sharjah",
      "permanent": true
    },
    {
      "source": "/ar/sat-preparation",
      "destination": "/ar/sat-preparation-sharjah",
      "permanent": true
    },
    {
      "source": "/webinar",
      "destination": "/webinar/ai",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1/[...path].py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path].py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}