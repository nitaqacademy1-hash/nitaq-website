{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "redirects": [
    {
      "source": "/sat-preparation",
      "destination": "/sat-preparation-sharjah",
      "permanent": true
    },
    {
      "source": "/ar/sat-preparation",
      "destination": "/ar/sat-preparation-sharjah",
      "permanent": true
    },
    {
      "source": "/webinar",
      "destination": "/webinar/ai",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/ar/:path*",
      "destination": "/ar/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}